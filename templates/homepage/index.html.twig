{% extends 'base.html.twig' %}

{% block title %}Hello HomepageController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>TRANSLATIONs {{ controller_name }}! ✅</h1>

    <h2>Basics</h2>
    {{ "friendly_msg"|trans }}

    <h2>Plural</h2>
    <div class="container">
        {% for i in range(0, 3) %}
            <p>{{ 'i_have_apples'|trans({"%apples%": i}) }}</p>
        {% endfor %}
    </div>

    <h2>Gender</h2>
    <div class="container">
        <p>{{ 'they_say'|trans({"%gender%": 'female', "%text%": "Hello!"}) }}</p>
    </div>

    <h2>Form</h2>
    <div class="container">
        {{ form(contact_form) }}
    </div>
</div>
{% endblock %}
