{% extends 'base.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block body %}
    <p>
        {{ 'account_reset_instructions'|trans }}
        {{ 'link_expiration'|trans }}{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>
    <p>
        {{ 'email_check'|trans }} 
        <a href="{{ path('app_forgot_password_request') }}">{{ 'try_again'|trans }}</a>.
    </p>
{% endblock %}
